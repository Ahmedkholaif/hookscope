{
  "name": "hookscope",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsc -p tsconfig.server.json --watch & node --watch dist/server/main.js",
    "build": "rm -rf dist && tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/main.js",
    "test": "tsc -p tsconfig.server.json && node --test --test-concurrency=1 \"dist/server/**/*.test.js\" && vitest run",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test:e2e": "playwright test"
  },
  "author": "",
  "license": "ISC",
  "description": "Live webhook inspector: Node.js (zero-dependency server, SSE) + React",
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "type": "module",
  "private": true
}
